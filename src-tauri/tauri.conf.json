{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ACC Overlay",
  "version": "0.2.3",
  "identifier": "com.accoverlay.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "control",
        "url": "control-panel/index.html",
        "title": "ACC Overlay \u2014 Control",
        "width": 1180,
        "height": 720,
        "minWidth": 900,
        "minHeight": 560,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "center": true,
        "visible": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/acc-engine"],
    "createUpdaterArtifacts": true,
    "resources": { "../src": "web" },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/leog1/RaceRipp_Overlay/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ4RkI3M0VENjA4QzcKUldUSENOWSt0NDhOQUg2Vmw5SWkxZm9Sb1pGcmx5aWlwTFVuTlF5ZCtJYmRLemtiak0rc3RqNjAK"
    }
  }
}