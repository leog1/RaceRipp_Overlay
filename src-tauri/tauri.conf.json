{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ACC Overlay",
  "version": "0.1.0",
  "identifier": "com.accoverlay.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "control",
        "url": "control-panel/index.html",
        "title": "ACC Overlay \u2014 Control",
        "width": 440,
        "height": 680,
        "minWidth": 380,
        "minHeight": 520,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "center": true,
        "visible": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/OWNER/REPO/releases/latest/download/latest.json"
      ],
      "pubkey": ""
    }
  }
}