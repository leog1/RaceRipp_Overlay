          "id": "col-edge",
          "type": "color",
          "label": "Kantlinje",
          "default": "#070807",
          "alpha": true
        },
        {
          "id": "col-grid",
          "type": "color",
          "label": "Rutnät",
          "default": "#ffffff0d",
          "alpha": true
        },
        {
          "id": "col-shadow",
          "type": "color",
          "label": "Skugga",
          "default": "#0000008c",
          "alpha": true
        }
      ],
      "presets": [
        {
          "id": "slot-1",
          "label": "Preset 1",
          "options": {}
        },
        {
          "id": "slot-2",
          "label": "Preset 2",
