          "values": [
            { "value": "best", "label": "Sessionens bästa varv" },
            { "value": "last", "label": "Förra varvet" },
            { "value": "motec", "label": "MoTeC-referensfil" },
            { "value": "off", "label": "Av" }
          ]
        },
        {
          "id": "window",
          "type": "float",
          "label": "Tidsfönster",
          "unit": " s",
          "default": 4.5,
          "min": 2,
          "max": 10,
          "step": 0.5
        },
        {
          "id": "col-green",
          "type": "color",
