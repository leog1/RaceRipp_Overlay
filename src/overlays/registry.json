{
  "overlays": [
    {
      "id": "delta-bar",
      "title": "Delta + Lap-time Row",
      "desc": "Delta mot referensvarv med varvtidsrad — session-bästa, förare och predikterad sluttid. Cirkeln fylls grönt när du vinner tid, rött när du tappar.",
      "url": "overlays/delta-bar/index.html",
      "baseWidth": 810,
      "baseHeight": 310,
      "defaultX": 460,
      "defaultY": 40,
      "defaultScale": 1.0,
      "hz": 30,
      "channels": [
        "refs",
        "delta",
        "sessionBestMs",
        "refTotalMs",
        "driverName"
      ],
      "options": [
        {
          "id": "predicted",
          "label": "Predicted-kolumn",
          "default": true
        },
        {
          "id": "delta-source",
          "type": "enum",
          "label": "Delta-källa",
          "default": "best",
          "values": [
            { "value": "best", "label": "Sessionens bästa varv" },
            { "value": "last", "label": "Förra varvet" },
            { "value": "motec", "label": "MoTeC-referensfil" },
            { "value": "off", "label": "Av" }
          ]
        },
        {
          "id": "col-green",
          "type": "color",
          "label": "Snabbare",
          "default": "#0DE622"
        },
        {
          "id": "col-red",
          "type": "color",
          "label": "Långsammare",
          "default": "#FF3B3B"
        },
        {
          "id": "col-amber",
          "type": "color",
          "label": "Accent (bästa)",
          "default": "#FBBF24"
        },
        {
          "id": "col-bar",
          "type": "color",
          "label": "Varvtidsradens bakgrund",
          "default": "#060708e6",
          "alpha": true,
          "gradient": true
        },
        {
          "id": "col-track",
          "type": "color",
          "label": "Mätarspår",
          "default": "#00000073",
          "alpha": true
        },
        {
          "id": "col-divider",
          "type": "color",
          "label": "Avdelare",
          "default": "#ffffff12",
          "alpha": true
        },
        {
          "id": "col-shadow",
          "type": "color",
          "label": "Skugga",
          "default": "#0000008c",
          "alpha": true
        }
      ],
      "presets": [
        {
          "id": "slot-1",
          "label": "Preset 1",
          "options": {}
        },
        {
          "id": "slot-2",
          "label": "Preset 2",
          "options": {}
        },
        {
          "id": "slot-3",
          "label": "Preset 3",
          "options": {}
        }
      ]
    },
    {
      "id": "inputs-trace",
      "title": "Inputs Trace",
      "desc": "Rullande gas/broms-trace med pedalstaplar. ABS färgar bromsen gul, TC färgar gasen blå.",
      "url": "overlays/inputs-trace/index.html",
      "baseWidth": 790,
      "baseHeight": 250,
      "defaultX": 40,
      "defaultY": 40,
      "defaultScale": 1.0,
      "hz": 30,
      "channels": [
        "throttle",
        "brake",
        "clutch",
        "abs",
        "tc",
        "refs"
      ],
      "options": [
        {
          "id": "clutch",
          "label": "Kopplingsstapel",
          "default": true
