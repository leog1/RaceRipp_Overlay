{
  "overlays": [
    {
      "id": "delta-bar",
      "title": "Delta + Lap-time Row",
      "desc": "Delta mot referensvarv med varvtidsrad — session-bästa, förare och predikterad sluttid. Cirkeln fylls grönt när du vinner tid, rött när du tappar.",
      "url": "overlays/delta-bar/index.html",
      "baseWidth": 1300,
      "baseHeight": 460,
      "defaultX": 460,
      "defaultY": 40,
      "defaultScale": 0.9,
      "hz": 30,
      "channels": [
        "delta",
        "sessionBestMs",
        "refTotalMs",
        "driverName"
      ],
      "options": [
        { "id": "predicted", "label": "Predicted-kolumn", "default": true }
      ]
    },
    {
      "id": "inputs-trace",
      "title": "Inputs Trace",
      "desc": "Rullande gas/broms-trace med pedalstaplar. ABS färgar bromsen gul, TC färgar gasen blå.",
      "url": "overlays/inputs-trace/index.html",
      "baseWidth": 600,
      "baseHeight": 200,
      "defaultX": 40,
      "defaultY": 40,
      "defaultScale": 1.0,
      "hz": 30,
      "channels": [
        "throttle",
        "brake",
        "clutch",
        "abs",
        "tc"
      ],
      "options": [
        { "id": "clutch", "label": "Kopplingsstapel", "default": true },
        { "id": "window", "type": "float", "label": "Tidsfönster", "unit": " s",
          "default": 4.5, "min": 2, "max": 10, "step": 0.5 }
      ]
    }
  ]
}
